# Copy this file to .env and change the values if needed. .env is not committed.

# Port the service listens on (all network interfaces, so a phone on the same Wi-Fi can reach it)
PORT=3000

# SQLite database file, created on first start
DATABASE_FILE=./data/exchange.db

# Lab 05 only: every request acts as this seeded test user.
# Replaced by login and session tokens in Lab 07.
DEV_USER_ID=1
