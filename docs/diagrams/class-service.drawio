<mxfile host="app.diagrams.net" type="device"><diagram id="class-service" name="class-service"><mxGraphModel dx="1000" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;AuthMiddleware&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;sessions table via db&lt;hr size='1'&gt;requireUser(req): userId&lt;br&gt;reject(res): 401" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="230" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style='text-align:center'&gt;&lt;i&gt;&amp;laquo;Express routers&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;Routes&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;/auth  -&amp;gt;  AuthService&lt;br&gt;/rates  -&amp;gt;  RateService&lt;br&gt;/wallet  -&amp;gt;  WalletService&lt;br&gt;/transactions  -&amp;gt;  TransactionService&lt;br&gt;/health&lt;br&gt;/dev/faults (development only)" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="330" height="146" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style='text-align:center'&gt;&lt;i&gt;&amp;laquo;development only&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;FaultInjector&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;delayMs: number&lt;br&gt;dropResponseAfterCommit: bool&lt;br&gt;failReadsOnce: bool&lt;br&gt;failNbp: bool&lt;hr size='1'&gt;set(config)&lt;br&gt;apply(req, res, next)" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="720" y="20" width="260" height="154" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;AuthService&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;db: Database&lt;br&gt;sessionTtlHours = 24&lt;hr size='1'&gt;register(email, password)&lt;br&gt;login(email, password)&lt;br&gt;logout(token)&lt;br&gt;userIdFor(token)" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="250" height="138" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style='text-align:center'&gt;&lt;b&gt;WalletService&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;db: Database&lt;hr size='1'&gt;getWallet(userId)&lt;br&gt;fund(userId, requestId, amount)" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="260" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style='text-align:center'&gt;&lt;b&gt;TransactionService&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;db: Database&lt;br&gt;rates: RateService&lt;hr size='1'&gt;buy(userId, requestId, code, amount)&lt;br&gt;sell(userId, requestId, code, amount)&lt;br&gt;findByRequestId(userId, requestId)&lt;br&gt;list(userId)" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="590" y="250" width="300" height="138" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Transaction&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id: integer&lt;br&gt;userId: integer&lt;br&gt;requestId: string&lt;br&gt;type: FUND | BUY | SELL&lt;br&gt;currency: string&lt;br&gt;amountMinor: integer&lt;br&gt;rateE4: integer | null&lt;br&gt;plnMinor: integer&lt;br&gt;createdAt: string" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="260" height="178" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style='text-align:center'&gt;&lt;b&gt;RateService&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;db: Database&lt;br&gt;maxCacheMinutes = 30&lt;br&gt;maxTableAgeDays = 7&lt;hr size='1'&gt;getCurrent(): RateTable&lt;br&gt;getHistory(code, days)&lt;br&gt;assertFresh(table)" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="590" y="448" width="300" height="138" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style='text-align:center'&gt;&lt;b&gt;NbpClient&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;baseUrl = api.nbp.pl/api&lt;hr size='1'&gt;fetchTableC()&lt;br&gt;fetchHistory(code, from, to)" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="590" y="636" width="300" height="90" as="geometry"/></mxCell><mxCell id="c11" value="checks token" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="254.8" y="40.0" width="70.3" height="16" as="geometry"/></mxCell><mxCell id="c12" value="wraps" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="672.3" y="50.0" width="35.3" height="16" as="geometry"/></mxCell><mxCell id="c13" value="calls" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="456.0" y="200.0" width="28.0" height