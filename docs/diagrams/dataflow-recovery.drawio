<mxfile host="app.diagrams.net" type="device"><diagram id="dataflow-recovery" name="dataflow-recovery"><mxGraphModel dx="940" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Mobile app&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=44;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55.0" y="20" width="170" height="745" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Web service&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=44;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="20" width="170" height="745" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;SQLite&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=44;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720.0" y="20" width="140" height="745" as="geometry"/></mxCell><mxCell id="c5" value="1. POST /transactions/buy {requestId: 7f3c...}" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="197.5" y="86.0" width="225.0" height="16" as="geometry"/></mxCell><mxCell id="c6" value="2. INSERT + COMMIT (request_id 7f3c...)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="530.7" y="126.0" width="208.7" height="16" as="geometry"/></mxCell><mxCell id="c7" value="3. 201 response lost" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290.0" y="171.0" width="104.0" height="16" as="geometry"/></mxCell><mxCell id="c8" value='4. no answer after 10 s: status UNKNOWN&lt;br&gt;show "Status unknown - checking"&lt;br&gt;new Buy is blocked' style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="212" width="320" height="60" as="geometry"/></mxCell><mxCell id="c9" value="5. connection returns:&lt;br&gt;NetInfo online and GET /health = 200" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="320" height="44" as="geometry"/></mxCell><mxCell id="c10" value="6. GET /transactions/7f3c..." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="240.8" y="349.0" width="138.3" height="16" as="geometry"/></mxCell><mxCell id="c11" value="7. SELECT by (user_id, request_id)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="546.0" y="389.0" width="178.0" height="16" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;alt [row found: server had committed (S5)]&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=235;height=22;fontSize=11;strokeColor=#7a7a7a;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="425" width="920" height="315" as="geometry"/></mxCell><mxCell id="c13" style="endArrow=none;dashed=1;html=1;strokeColor=#7a7a7a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="10" y="555" as="sourcePoint"/><mxPoint x="930" y="555" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;[not found: request never arrived (S4)]&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="14" y="556" width="206.66666666666666" height="16" as="geometry"/></mxCell><mxCell id="c15" value="8a. 200 {transaction}" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="257.2" y="456.0" width="105.7" height="16" as="geometry"/></mxCell><mxCell id="c16" value='CONFIRMED: "Purchase completed"&lt;br&gt;refresh wallet and history' style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="320" height="44" as="geometry"/></mxCell><mxCell id="c17" value="8b. 404 NOT_FOUND" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="253.2" y="581.0" width="113.7" height="16" as="geometry"/></mxCell><mxCell id="c18" value='NOT_RECEIVED: "Not completed, try again?"' style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="615" width="320" height="28" as="geometry"/></mxCell><mxCell id="c19" value="9. POST again with the same requestId" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="212.2" y="649.0" width="195.7" height="16" as="geometry"/></mxCell><mxCell id="c20" value="INSERT + COMMIT" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="583.5" y="679.0" width="103.0" height="16" as="geometry"/></mxCell><mxCell id="c21" value="10. 201 {transaction}" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="257.2" y="709.0" width="105.7" height="16" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;A repeated request with the same requestId never creates a second row:&lt;/b&gt;&lt;br&gt;UNIQUE (user_id, request_id) in the transactions table (N6)." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fillColor=#d5e8d4;strokeColor=#3b7d23;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="778" width="620" height="44" as="geometry"/></mxCell><mxCell id="c23" value="Red arrows cross the wireless segment: the request or the response can be lost." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="838.0" width="394.7" height="16" as="geometry"/></mxCell><mxCell id="c24" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="105" as="sourcePoint"/><mxPoint x="480" y="105" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#262626;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="145" as="sourcePoint"/><mxPoint x="790" y="145" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" style="html=1;rounded=0;endArrow=cross;endFill=0;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="190" as="sourcePoint"/><mxPoint x="205" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="368" as="sourcePoint"/><mxPoint x="480" y="368" as="targetPoint"/>