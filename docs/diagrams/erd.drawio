<mxfile host="app.diagrams.net" type="device"><diagram id="erd" name="erd"><mxGraphModel dx="980" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;div style='text-align:center'&gt;&lt;b&gt;users&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;PK  id: INTEGER&lt;br&gt;email: TEXT, UNIQUE, NOT NULL&lt;br&gt;password_hash: TEXT, NOT NULL&lt;br&gt;created_at: TEXT (ISO 8601)" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="300" height="98" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;sessions&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;PK  token: TEXT&lt;br&gt;FK  user_id: INTEGER -&amp;gt; users.id&lt;br&gt;expires_at: TEXT" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="300" height="82" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;wallets&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;PK, FK  user_id: INTEGER -&amp;gt; users.id&lt;br&gt;PK  currency: TEXT (PLN, USD, EUR, GBP)&lt;br&gt;balance_minor: INTEGER, CHECK &amp;gt;= 0&lt;br&gt;updated_at: TEXT" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="410" y="20" width="320" height="98" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;transactions&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;PK  id: INTEGER&lt;br&gt;FK  user_id: INTEGER -&amp;gt; users.id&lt;br&gt;request_id: TEXT&lt;br&gt;type: TEXT (FUND, BUY, SELL)&lt;br&gt;currency: TEXT&lt;br&gt;amount_minor: INTEGER, CHECK &amp;gt; 0&lt;br&gt;rate_e4: INTEGER (NULL for FUND)&lt;br&gt;pln_minor: INTEGER&lt;br&gt;created_at: TEXT&lt;br&gt;UNIQUE (user_id, request_id)" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="410" y="200" width="320" height="194" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style='text-align:center'&gt;&lt;b&gt;rate_cache&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;PK  code: TEXT&lt;br&gt;table_no: TEXT&lt;br&gt;effective_date: TEXT&lt;br&gt;bid_e4: INTEGER&lt;br&gt;ask_e4: INTEGER&lt;br&gt;fetched_at: TEXT" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="770" y="20" width="200" height="130" as="geometry"/></mxCell><mxCell id="c7" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="328.0" y="54.0" width="12.0" height="16" as="geometry"/></mxCell><mxCell id="c8" value="4" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="390.0" y="54.0" width="12.0" height="16" as="geometry"/></mxCell><mxCell id="c9" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="328.0" y="99.0" width="12.0" height="16" as="geometry"/></mxCell><mxCell id="c10" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380.8" y="280.0" width="22.3" height="16" as="geometry"/></mxCell><mxCell id="c11" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="178.0" y="144.0" width="12.0" height="16" as="geometry"/></mxCell><mxCell id="c12" value="0..*" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5a5a5a;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="178.8" y="248.0" width="22.3" height="16" as="geometry"/></mxCell><mxCell id="c13" value="No foreign key: the rate used&lt;br&gt;is copied into&lt;br&gt;transactions.rate_e4 when&lt;br&gt;the trade is executed." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="210" height="76" as="geometry"/></mxCell><mxCell id="c14" value="Money is stored as INTEGER in minor units (grosz / cents); rates as INTEGER x 10 000.&lt;br&gt;UNIQUE (user_id, request_id): a repeated request cannot be stored twice (N6).&lt;br&gt;CHECK (balance_minor &amp;gt;= 0): a balance can never become negative (N10)." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="710" height="60" as="geometry"/></mxCell><mxCell id="c15" style="html=1;rounded=0;endArrow=none;strokeColor=#262626;strokeWidth=1.5;exitX=1;exitY=0.32653061224489793;exitDx=0;exitDy=0;entryX=0;entryY=0.5306122448979592;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="72.0" as="sourcePoint"/><mxPoint x="410" y="72.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" style="html=1;rounded=0;endArrow=none;strokeColor=#262626;strokeWidth=1.5;exitX=1;exitY=0.7959183673469388;exitDx=0;exitDy=0;entryX=0;entryY=0.515463917525773